    {
      "id": "WALNUT",
      "name": "Walnut",
      "hex": "#6B3F2A",
      "type": "woodgrain",
      "light": "#8A5A42",
      "dark": "#4E2C18",
      "darkSurface": true,
      "texture": "walnut.jpg",
      "textureStatus": "catalogue",
      "textureSource": "frontend/public/assets/doors/kanata/sheridan-xl/walnut.jpg",
      "textureCrop": [1380, 1860, 420, 420],
      "grainAxis": "horizontal",
      "grainTile": 200,
      "alongGrain": 1.8,
      "sharpen": 0.25,
      "swatch": "walnut.jpg",
      "textureNote": "Seamless tile cut from the interior of one raised panel on the Upwardor Sheridan XL walnut catalogue photo. Grain in that photo runs horizontally, same as the installed doors."
    },
    {
      "id": "ENGLISH_CHESTNUT",
      "name": "English Chestnut",
      "hex": "#80583A",
      "type": "woodgrain",
      "light": "#A67A56",
      "dark": "#5A3214",
      "darkSurface": true,
      "texture": "english-chestnut.jpg",
      "textureStatus": "catalogue",
      "textureSource": "packages/door-renderer/sources/english-chestnut.jpg",
      "textureCrop": [380, 980, 740, 740],
      "textureRotate": 90,
      "grainAxis": "horizontal",
      "grainTile": 260,
      "grainContrast": 1.28,
      "warmth": 0.85,
      "sharpen": 0.45,
      "swatch": "english-chestnut.jpg",
      "textureNote": "Real tile from an indoor-daylight close-up of an English Chestnut section. The sample was stood on end, so grain runs vertically in the photo; it is rotated 90 degrees so the tile matches installed doors. Catalogue walnut and Craft photos, and an evening chestnut install, all read horizontal. The tile is warmed and the grain contrast is raised so the reddish-brown and the dark streaks match that close-up rather than a greyer, flatter reading. Hex is the median of the graded tile."
    },
    {
      "id": "FRENCH_OAK",
      "name": "French Oak",
      "hex": "#C7A984",
      "type": "woodgrain",
      "light": "#E8D2A2",
      "dark": "#9A8158",
      "texture": "french-oak.jpg",
      "textureStatus": "catalogue",
      "textureSource": "packages/door-renderer/sources/french-oak.jpg",
      "textureCrop": [200, 450, 1200, 150],
      "preserveAspect": true,
      "recolorToHex": true,
      "grainAxis": "horizontal",
      "grainTile": 300,
      "grainTileHeight": 38,
      "grainContrast": 0.62,
      "alongGrain": 0.7,
      "sharpen": 0.15,
      "swatch": "french-oak.jpg",
      "textureNote": "Grain figure is a flat panel-face strip from the close-up (sources/french-oak.jpg). The right-edge frame and the raised-panel bevels are outside the crop. That close-up's light made the wood look grey, so the tile is recoloured onto hex with low contrast so the cathedral figure stays soft. An overcast daylight install measures about #C6A883 on the lower panels (Joey's sample #C3A686). #C7A984 sits on that reading, only slightly warmer."
    },
