    {
      "id": "ENGLISH_CHESTNUT",
      "name": "English Chestnut",
      "hex": "#735444",
      "type": "woodgrain",
      "light": "#8E6E5D",
      "dark": "#563A2B",
      "darkSurface": true,
      "texture": "english-chestnut.jpg",
      "textureStatus": "catalogue",
      "textureSource": "packages/door-renderer/sources/english-chestnut.jpg",
      "textureCrop": [380, 980, 740, 740],
      "textureRotate": 90,
      "grainAxis": "horizontal",
      "grainTile": 132,
      "poreEmboss": 0.35,
      "swatch": "english-chestnut.jpg",
      "textureNote": "Real tile from an indoor-daylight close-up of an English Chestnut section. The sample was stood on end, so grain runs vertically in the photo; it is rotated 90 degrees so the tile matches installed doors. Catalogue walnut (Kanata SH/SHXL/flush and Craft Muskoka/Denison/Granville) and an evening install of two chestnut doors all read horizontal across the section. Hex #735444 is the median of the seamless tile (reddish medium brown). The evening photo is only a sanity check: after removing the warm lamp cast against the adjacent siding, its midtone (#6C503D) is the same hue, a bit darker from the night exposure. A light pore emboss is baked in. Replacing sources/english-chestnut.jpg and rerunning the texture script replaces the tile."
    },
